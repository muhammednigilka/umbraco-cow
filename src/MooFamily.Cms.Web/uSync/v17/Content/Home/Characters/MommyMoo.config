    <characterLearnPoints>
      <Value><![CDATA[{"contentData":[{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000011","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Understanding Emotions","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Mommy Moo helps children name and understand how they feel.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000012","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Creativity and Play","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>She turns learning into play, sparking imagination at every turn.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000013","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Patience and Listening","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>She shows that taking time to listen makes everyone feel valued.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000014","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Encouraging Confidence","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Her gentle encouragement helps children believe in themselves.</p>","segment":null}]}],"settingsData":[],"layout":{"Umbraco.BlockList":[{"contentKey":"d0000000-0000-0000-0000-000000000011"},{"contentKey":"d0000000-0000-0000-0000-000000000012"},{"contentKey":"d0000000-0000-0000-0000-000000000013"},{"contentKey":"d0000000-0000-0000-0000-000000000014"}]},"expose":[{"culture":null,"contentKey":"d0000000-0000-0000-0000