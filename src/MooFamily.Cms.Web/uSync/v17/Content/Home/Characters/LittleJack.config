    <characterDescription>
      <Value><![CDATA[Jack is a young cow growing up on the Island — curious, observant, and quietly emotional. Jack often doubts himself when others seem faster, louder, or more confident.]]></Value>
    </characterDescription>
    <characterAccentColor>
