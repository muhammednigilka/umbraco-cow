    <blocks>
      <Value><![CDATA[{"contentData":[{"contentTypeKey":"f4a00001-0000-0000-0000-000000000001","key":"ac000901-0000-0000-0000-000000000901","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroSectionId","value":"contact-hero","segment":null},{"culture":null,"editorAlias":"Umbraco.MediaPicker3","alias":"pageHeroBackgroundImage","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroBackgroundImageAlt","value":"Contact background","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroEyebrow","value":"Contact","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroHeading","value":"Get in Touch","segment":null},{"culture":null,"editorAlias":"Umbraco.TextArea","alias":"pageHeroSubheading","value":"Questions, feedback, or just want to say hello? We would love to hear from you.","segment":null},{"culture":null,"editorAlias":"Umbraco.MediaPicker3","alias":"pageHeroLogoImage","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroCtaPrimaryLabel","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroCtaPrimaryUrl","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.MediaPicker3","alias":"pageHeroCtaPrimaryImage","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroCtaSecondaryLabel","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"pageHeroCtaSecondaryUrl","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.MediaPicker3","alias":"pageHeroCtaSecondaryImage","value":"","segment":null}]},{"contentTypeKey":"f4a00005-0000-0000-0000-000000000005","key":"ac000902-0000-0000-0000-000000000902","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"richTextImageSectionId","value":"contact-details","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"richTextImageHeading","value":"Reach the Moo Family","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"richTextImageBody","value":"<p>We would love to hear from you. For general questions, partnerships, or press, email us at <a href=\"mailto:hello@cowparadisegames.com\">hello@cowparadisegames.com</a>.</p><p>You can also find us on <a href=\"https://facebook.com/cowparadisegames\" target=\"_blank\" rel=\"noopener\">Facebook</a>, <a href=\"https://instagram.com/cowparadisegames\" target=\"_blank\" rel=\"noopener\">Instagram</a>, and <a href=\"https://x.com/cowparadisegames\" target=\"_blank\" rel=\"noopener\">X</a>.</p>","segment":null},{"culture":null,"editorAlias":"Umbraco.MediaPicker3","alias":"richTextImageImage","value":"","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"richTextImageImageAlt","value":"The Moo Family waving hello","segment":null},{"culture":null,"editorAlias":"Umbraco.DropDown.Flexible","alias":"richTextImagePosition","value":"[\"right\"]","segment":null}]},{"contentTypeKey":"e1a00006-0000-0000-0000-000000000006","key":"ac000903-0000-0000-0000-000000000903","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"newsletterTitle","value":"Stay in the loop","segment":null},{"culture":null,"editorAlias":"Umbraco.TextArea","alias":"newsletterDescription","value":"Get a short email when we ship a new game, character, or story. No spam -- ever.","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"newsletterCtaLabel","value":"Subscribe","segment":null},{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"newsletterPlaceholder","value":"Enter your email","segment":null}]}],"settingsData":[],"layout":{"Umbraco.BlockList":[{"contentKey":"ac000901-0000-0000-0000-000000000901"},{"contentKey":"ac000902-0000-0000-0000-000000000902"},{"contentKey":"ac000903-0000-0000-0000-000000000903"}]},"expose":[{"culture":null,"contentKey":"ac000901-0000-0000-0000-000000000901","segment":null},{"culture":null