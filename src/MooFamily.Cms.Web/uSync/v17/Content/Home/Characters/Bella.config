    <characterLearnPoints>
      <Value><![CDATA[{"contentData":[{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000015","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Kindness Every Day","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Bella shows that everyday kindness brightens the whole Island.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000016","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Including Others","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>She makes sure no friend is ever left out of the fun.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000017","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Honesty and Trust","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Bella teaches that telling the truth builds strong friendships.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000018","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Listening with Care","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>She listens first, helping friends feel understood.</p>","segment":null}]}],"settingsData":[],"layout":{"Umbraco.BlockList":[{"contentKey":"d0000000-0000-0000-0000-000000000015"},{"contentKey":"d0000000-0000-0000-0000-000000000016"},{"contentKey":"d0000000-0000-0000-0000-000000000017"},{"contentKey":"d0000000-0000-0000-0000-000000000018"}]},"expose":[{"culture":null,"contentKey":"d0000000-0000-0000-0000-000000000015","segment":null},{"cul