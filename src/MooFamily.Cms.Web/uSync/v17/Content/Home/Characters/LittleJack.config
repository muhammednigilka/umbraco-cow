      <Value><![CDATA[Playful, Curious, Brave, Learns from mistakes, Never gives up, Kind-hearted]]></Value>
    </characterTraits>
    <characterPersonality>
      <Value><![CDATA[Jack is a young cow growing up on the Island — curious, observant, and quietly emotional. Jack often doubts himself when others seem faster, louder, or more confident.]]></Value>
    </characterPersonality>
    <characterTakeaway>
      <Value><![CDATA[He discovers that his real strength is thoughtfulness, empathy, and gentle courage.]]></Value>
    </characterTakeaway>
    <characterLearnIntro>
      <Value><![CDATA[Little Jack explores the world with curiosity. Through stories, games, and adventures, children learn important life skills while having fun.]]></Value>
    </characterLearnIntro>
    <characterLearnPoints>
      <Value><![CDATA[{"contentData":[{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000001","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Discover Through Curiosity","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Jack's questions turn everyday moments into little adventures, encouraging children to explore and ask why.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000002","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Learning from Mistakes","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Every stumble is a lesson. Jack shows that getting it wrong is just part of figuring it out.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000003","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Curiosity and Problem Solving","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Jack tackles challenges one playful step at a time, building confidence with each small win.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000004","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Teamwork and Friendship","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Jack learns that asking for help and helping others makes every adventure better.</p>","segment":null}]}],"settingsData":[],"layout":{"Umbraco.BlockList":[{"contentKey":"d0000000-0000-0000-0000-000000000001"},{"contentKey":"d0000000-0000-0000-0000-000000000002"},{"contentKey":"d0000000-0000-0000-0000-000000000003"},{"contentKey":"d0000000-0000-0000-0000-000000000004"}]},"expose":[{"culture":null,"contentKey":"d0000000-0000-0000-0000-000000000001","segment":null},{"culture":null,"contentKey":"d0000000-0000-0000-0000-000000000002","segment":null},{"culture":null,"contentKey":"d0000000-0000-0000-0000-000000000003","segment":null},{"culture":null,"contentKey":"d0000000-0000-0000-0000-000000000004","segment":null}]}]]></Value>
