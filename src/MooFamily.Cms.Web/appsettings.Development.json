{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      },
      "DeliveryApi": {
        "PublicAccess": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "// ImportAtStartup": "Schema only, matching Production. Content is owned by editors in the backoffice; importing it here would overwrite their changes on every restart.",
      "ImportAtStartup": "Settings"
    }
  }
}
