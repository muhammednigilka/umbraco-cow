    <characterLearnPoints>
      <Value><![CDATA[{"contentData":[{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000021","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Speaking Up","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Zara shows that sharing your voice takes a little brave practice.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000022","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Staying Positive","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Her humor keeps spirits high, even on tough days.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000023","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Making Friends","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Zara welcomes everyone with warmth and a quick smile.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000024","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Believing in Yourself","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>She encourages children to trust their own abilities.</p>","segment":null}]}],"settingsData":[],"layout":{"Umbraco.BlockList":[{"contentKey":"d0000000-0000-0000-0000-000000000021"},{"contentKey":"d0000000-0000-0000-0000-000000000022"},{"contentKey":"d0000000-0000-0000-0000-000000000023"},{"contentKey":"d0000000-0000-0000-0000-000000000024"}]},"expose":[{"culture":null,"contentKey":"d0000000-0000-0000-0000-000000000021","segment":null},{"culture":null,"conte