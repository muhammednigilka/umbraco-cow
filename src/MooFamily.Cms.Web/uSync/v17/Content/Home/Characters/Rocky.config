      <Value><![CDATA[Rocky's adventures teach children to be bold, set goals, and keep going even when the path gets tricky.]]></Value>
    </characterLearnIntro>
    <characterLearnPoints>
      <Value><![CDATA[{"contentData":[{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-000000000019","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Being Brave","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Rocky shows that courage means facing the unknown with a smile.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-00000000001a","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Setting Goals","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>He sets his sights high and works toward every dream.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-00000000001b","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Never Giving Up","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>Rocky keeps going, turning obstacles into stepping stones.</p>","segment":null}]},{"contentTypeKey":"e1a00005-0000-0000-0000-000000000005","key":"d0000000-0000-0000-0000-00000000001c","values":[{"culture":null,"editorAlias":"Umbraco.TextBox","alias":"accordionTitle","value":"Exploring Safely","segment":null},{"culture":null,"editorAlias":"Umbraco.RichText","alias":"accordionContent","value":"<p>He teaches that smart explorers plan ahead and look out for friends.</p>","segment":null}]}],"settingsData":[],"layout":{"Umbraco.BlockList":[{"contentKey":"d0000000-0000-0000-0000-000000000019"},{"contentKey":"d0000000-0000-0000-0000-00000000001a"},{"contentKey":"d0000000-0000-0000-0000-00000000001b"},{"contentKey":"d0000000-0000-0000-0000-00000000001c"}]},"expose":[{"culture":null,"contentKey":"d0000000-0000-0000-0000-000000000019","segment":null},{"culture":null,"contentKey":"d0000000-0000-0000-0000-00000000001a","segment":null},{"culture":null,"contentKey":"d0000000-0000-0000-0000-00000000001b","segment":null},{"culture":null,"contentKey":"d0000000-0000-0000-0000-00000000001c","segment":null}]}]]></Value>
